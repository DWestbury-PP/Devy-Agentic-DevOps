# Managed by the host_mcp_native Ansible role — do not edit by hand.
# The bearer token is the SAME secret the proxy sends ({{ hmcp_token_secret }}).
HOST_MCP_TRANSPORT=http
HOST_MCP_HOST={{ hmcp_bind }}
HOST_MCP_PORT={{ hmcp_port }}
HOST_MCP_PROFILE={{ hmcp_profile }}
HOST_MCP_TOKEN={{ hmcp_token }}
HOST_MCP_AUDIT={{ hmcp_audit_dir }}/audit.jsonl
{% if hmcp_allow_mutations %}
# ENHANCED MODE ENABLED (operator-set, restart-gated). systemctl verbs still need a
# matching scoped OS privilege grant to actually run.
HOST_MCP_ALLOW_MUTATIONS=true
{% else %}
# Immutability is the default — mutations OFF. To enable enhanced mode, set
# hmcp_allow_mutations=true and redeploy (read only at startup; self-reverts).
{% endif %}
