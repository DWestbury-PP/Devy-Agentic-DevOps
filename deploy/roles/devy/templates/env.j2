# Rendered by the `devy` Ansible deploy role — do not edit on the host.
# One coherent release (the source manifest is recorded in SSM {{ devy_ssm_deployed_prefix }}/{{ devy_env_name }}/{{ inventory_hostname }}).
# Compose reads this .env from the project dir for ${DEVY_*_IMAGE} substitution + deploy config.
DEVY_PROXY_IMAGE={{ devy_images['proxy'] }}
DEVY_CHAT_UI_IMAGE={{ devy_images['chat-ui'] }}
{# host-mcp is native (systemd) now, not a compose image — no DEVY_HOST_MCP_IMAGE #}

# Host config dir mounted at /config (proxy reads config.yaml here; no secrets on disk in prod).
AGENTIC_DEVOPS_CONFIG_DIR={{ devy_config_dir }}
{% for k, v in devy_env.items() %}
{{ k }}={{ v }}
{% endfor %}
{% if devy_blobs_bucket %}
# S3 blob bucket for image attachments (config.yaml expands ${DEVY_BLOBS_BUCKET}).
DEVY_BLOBS_BUCKET={{ devy_blobs_bucket }}
{% endif %}
{% if devy_grafana_url %}
# Grafana tenant URL for the grafana-mcp sidecar + config.yaml's ${GRAFANA_URL} grounding.
GRAFANA_URL={{ devy_grafana_url }}
{% endif %}
{% if devy_edge_al2023_url %}
# Native edge host-MCP sidecar URLs (config.yaml expands ${EDGE_*_MCP_URL}).
EDGE_AL2023_MCP_URL={{ devy_edge_al2023_url }}
{% endif %}
{% if devy_edge_ubuntu_url %}
EDGE_UBUNTU_MCP_URL={{ devy_edge_ubuntu_url }}
{% endif %}
