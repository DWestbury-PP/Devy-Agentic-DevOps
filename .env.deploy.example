# .env.deploy.example — image URIs for the AWS deploy variant (docker-compose-aws.yml).
#
# The CI/CD pipeline (Devy's `deploy/` role) renders these onto the deploy host's .env from
# the release manifest (the SSM Parameter Store entry keyed by the built commit sha). You only
# set them by hand to TEST the AWS compose file locally:
#   docker compose -f docker-compose-aws.yml up -d proxy host-mcp chat-ui postgres
#
# Find the latest pushed tag for a component in ECR, e.g.:
#   aws ecr describe-images --repository-name devy-proxy --region us-east-1 \
#     --query 'sort_by(imageDetails,&imagePushedAt)[-1].imageTags[0]' --output text
# then form the URI as <account>.dkr.ecr.<region>.amazonaws.com/<repo>:<tag>.
#
# IMPORTANT: all three MUST reference the SAME coherent build (one manifest / one
# commit) — components move together (deploy-design.md). Do not mix builds.
#
# (Placeholders — substitute your own account, region, and the current release tag.)

DEVY_PROXY_IMAGE=<account>.dkr.ecr.<region>.amazonaws.com/devy-proxy:<branch>-<sha>-<stamp>
DEVY_HOST_MCP_IMAGE=<account>.dkr.ecr.<region>.amazonaws.com/devy-host-mcp:<branch>-<sha>-<stamp>
DEVY_CHAT_UI_IMAGE=<account>.dkr.ecr.<region>.amazonaws.com/devy-chat-ui:<branch>-<sha>-<stamp>
