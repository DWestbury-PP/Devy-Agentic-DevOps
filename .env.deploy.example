# .env.deploy.example — image URIs for the DEPLOY variant (docker-compose.deploy.yml).
#
# The CI/CD pipeline renders these onto the deploy host's .env from the release manifest
# (the SSM Parameter Store entry keyed by the built commit sha). You only set them by
# hand to TEST the deploy variant locally: `./devy.sh --deploy up`.
#
# Find the latest pushed tag for a component in ECR, e.g.:
#   aws ecr describe-images --repository-name devy-proxy --region us-east-1 \
#     --query 'sort_by(imageDetails,&imagePushedAt)[-1].imageTags[0]' --output text
# then form the URI as <account>.dkr.ecr.<region>.amazonaws.com/<repo>:<tag>.
#
# IMPORTANT: all three MUST reference the SAME coherent build (one manifest / one
# commit) — components move together (deploy-design.md). Do not mix builds.
#
# (The values below are the first pushed build — replace with your current release.)

DEVY_PROXY_IMAGE=083084509839.dkr.ecr.us-east-1.amazonaws.com/devy-proxy:main-d12d927-20260726T213553Z
DEVY_HOST_MCP_IMAGE=083084509839.dkr.ecr.us-east-1.amazonaws.com/devy-host-mcp:main-d12d927-20260726T213554Z
DEVY_CHAT_UI_IMAGE=083084509839.dkr.ecr.us-east-1.amazonaws.com/devy-chat-ui:main-d12d927-20260726T213556Z
